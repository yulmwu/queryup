{
    "name": "queryup-backend",
    "version": "0.0.1",
    "description": "",
    "author": "yulmwu",
    "private": true,
    "license": "MIT",
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "typeorm": "typeorm-ts-node-commonjs",
        "migration:generate": "npm run typeorm -- migration:generate src/migrations/Init --dataSource=typeorm.config.ts",
        "migration:run": "npm run typeorm -- migration:run --dataSource=typeorm.config.ts",
        "migration:revert": "npm run typeorm -- migration:revert --dataSource=typeorm.config.ts",
        "migration:rm": "rm -rf src/migrations/*",
        "migration:init": "npm run migration:rm && npm run migration:generate && npm run migration:run",
        "migration:reset": "npm run migration:revert && npm run migration:init",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:integration": "jest -c jest.integration.config.js --runInBand",
        "test:all": "npm run test && npm run test:integration"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.859.0",
        "@aws-sdk/s3-presigned-post": "^3.863.0",
        "@aws-sdk/s3-request-presigner": "^3.893.0",
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.17",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/mapped-types": "^2.1.0",
        "@nestjs/microservices": "^11.1.6",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.17",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/typeorm": "^11.0.0",
        "@types/archiver": "^7.0.0",
        "@types/multer": "^2.0.0",
        "@types/passport-local": "^1.0.38",
        "archiver": "^7.0.1",
        "bcrypt": "^6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.4",
        "cliui": "^9.0.1",
        "cookie-parser": "^1.4.7",
        "ioredis": "^5.6.1",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "uuid": "^13.0.0",
        "yargs": "^18.0.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.1.17",
        "@swc/cli": "^0.7.10",
        "@swc/core": "^1.10.7",
        "@testcontainers/postgresql": "^11.13.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/express": "^5.0.5",
        "@types/jest": "^29.5.12",
        "@types/node": "^25.5.0",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "testcontainers": "^11.13.0",
        "ts-jest": "^29.2.6",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm": "^0.3.28",
        "typeorm-ts-node-commonjs": "^0.3.20",
        "typescript": "^5.7.3"
    }
}
